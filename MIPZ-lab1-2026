import sys
import os

BOARD_SIZE = 19
WIN_STREAK = 5

def solve():
    file_path = 'input.txt'
    
    if not os.path.exists(file_path):
        print(f"Помилка: Файл '{file_path}' не знайдено!")
        return

    with open(file_path, 'r') as f:
        input_data = f.read().split()
        
    if not input_data:
        return
    
    # t = кількість ігор (test cases)
    t = int(input_data[0]) 
    idx = 1
    
    directions = [(0, 1), (1, 0), (1, 1), (-1, 1)]
    
    for _ in range(t):
        # Захист: перевіряємо, чи вистачає цифр у файлі для побудови повної дошки
        if idx + (BOARD_SIZE * BOARD_SIZE) > len(input_data):
            print("Помилка: У файлі недостатньо даних для побудови дошки!")
            break

        # Будуємо матрицю, використовуючи константу BOARD_SIZE
        board = []
        for r in range(BOARD_SIZE):
            row = []
            for c in range(BOARD_SIZE):
                row.append(int(input_data[idx]))
                idx += 1
            board.append(row)
            
        winner = 0
        win_r = -1
        win_c = -1
        
        for r in range(BOARD_SIZE):
            for c in range(BOARD_SIZE):
                if board[r][c] == 0:
                    continue
                
                color = board[r][c]
                
                for dr, dc in directions:
                    # Перевіряємо чи кінець серії з WIN_STREAK каменів не виходить за межі
                    # Віднімаємо 1, бо перший камінь - це поточна клітинка (step 0)
                    end_r = r + (WIN_STREAK - 1) * dr
                    end_c = c + (WIN_STREAK - 1) * dc
                    
                    if 0 <= end_r < BOARD_SIZE and 0 <= end_c < BOARD_SIZE:
                        match = True
                        for step in range(1, WIN_STREAK):
                            if board[r + step * dr][c + step * dc] != color:
                                match = False
                                break
                        
                        if match:
                            # Перевіряємо наявність каменів ДО та ПІСЛЯ серії
                            prev_r, prev_c = r - dr, c - dc
                            next_r, next_c = r + WIN_STREAK * dr, c + WIN_STREAK * dc
                            
                            prev_match = (0 <= prev_r < BOARD_SIZE and 0 <= prev_c < BOARD_SIZE and board[prev_r][prev_c] == color)
                            next_match = (0 <= next_r < BOARD_SIZE and 0 <= next_c < BOARD_SIZE and board[next_r][next_c] == color)
                                
                            if not prev_match and not next_match:
                                winner = color
                                win_r = r + 1 
                                win_c = c + 1 
                                break
                
                if winner != 0:
                    break
            if winner != 0:
                break
        
        if winner != 0:
            print(winner)
            print(f"{win_r} {win_c}")
        else:
            print(0)

if __name__ == '__main__':
    solve()
