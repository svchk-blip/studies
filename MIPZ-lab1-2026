import sys

def solve():
    # Read all inputs from standard input
    input_data = sys.stdin.read().split()
    if not input_data:
        return
    
    t = int(input_data[0])
    idx = 1
    
    # Directions: (row_delta, col_delta)
    # Checking Right, Down, Down-Right, Up-Right ensures we always 
    # start from the leftmost (or uppermost) stone.
    directions = [
        (0, 1),   # Right
        (1, 0),   # Down
        (1, 1),   # Down-Right
        (-1, 1)   # Up-Right
    ]
    
    for _ in range(t):
        # Build the 19x19 board for the current testcase
        board = []
        for r in range(19):
            row = []
            for c in range(19):
                row.append(int(input_data[idx]))
                idx += 1
            board.append(row)
            
        winner = 0
        win_r = -1
        win_c = -1
        
        # Scan the board
        for r in range(19):
            for c in range(19):
                if board[r][c] == 0:
                    continue
                
                color = board[r][c]
                
                for dr, dc in directions:
                    # Check if the 5th stone is within the board boundaries
                    end_r = r + 4 * dr
                    end_c = c + 4 * dc
                    
                    if 0 <= end_r < 19 and 0 <= end_c < 19:
                        # Verify all 5 stones in this direction match the color
                        match = True
                        for step in range(1, 5):
                            if board[r + step * dr][c + step * dc] != color:
                                match = False
                                break
                        
                        if match:
                            # Verify the "exactly 5" rule (no overlines)
                            prev_r = r - dr
                            prev_c = c - dc
                            next_r = r + 5 * dr
                            next_c = c + 5 * dc
                            
                            prev_match = (0 <= prev_r < 19 and 0 <= prev_c < 19 and board[prev_r][prev_c] == color)
                            next_match = (0 <= next_r < 19 and 0 <= next_c < 19 and board[next_r][next_c] == color)
                                
                            if not prev_match and not next_match:
                                winner = color
                                win_r = r + 1 # Convert to 1-based index
                                win_c = c + 1 # Convert to 1-based index
                                break
                
                if winner != 0:
                    break
            if winner != 0:
                break
        
        # Output the results for the current test case
        if winner != 0:
            print(winner)
            print(f"{win_r} {win_c}")
        else:
            print(0)

if __name__ == '__main__':
    solve()
