import sys
import os

def solve():
    file_path = 'input.txt'
    
    # 1. Перевіряємо, чи існує файл з даними
    if not os.path.exists(file_path):
        print(f"Помилка: Файл '{file_path}' не знайдено!")
        print("Створи файл input.txt у тій самій папці і встав туди тестову матрицю 19x19.")
        return

    # 2. Зчитуємо дані
    with open(file_path, 'r') as f:
        input_data = f.read().split()
        
    if not input_data:
        print("Файл порожній!")
        return
    
    t = int(input_data[0])
    idx = 1
    
    # Вправо, Вниз, Вниз-Вправо, Вгору-Вправо
    directions = [(0, 1), (1, 0), (1, 1), (-1, 1)]
    
    for _ in range(t):
        # Будуємо матрицю
        board = []
        for r in range(19):
            row = []
            for c in range(19):
                row.append(int(input_data[idx]))
                idx += 1
            board.append(row)
            
        winner = 0
        win_r = -1
        win_c = -1
        
        # Шукаємо переможні 5 каменів
        for r in range(19):
            for c in range(19):
                if board[r][c] == 0:
                    continue
                
                color = board[r][c]
                
                for dr, dc in directions:
                    end_r = r + 4 * dr
                    end_c = c + 4 * dc
                    
                    if 0 <= end_r < 19 and 0 <= end_c < 19:
                        match = True
                        for step in range(1, 5):
                            if board[r + step * dr][c + step * dc] != color:
                                match = False
                                break
                        
                        if match:
                            # Перевіряємо, чи немає 6-го каменя (щоб було рівно 5)
                            prev_r, prev_c = r - dr, c - dc
                            next_r, next_c = r + 5 * dr, c + 5 * dc
                            
                            prev_match = (0 <= prev_r < 19 and 0 <= prev_c < 19 and board[prev_r][prev_c] == color)
                            next_match = (0 <= next_r < 19 and 0 <= next_c < 19 and board[next_r][next_c] == color)
                                
                            if not prev_match and not next_match:
                                winner = color
                                win_r = r + 1 # в задачі координати з 1
                                win_c = c + 1 
                                break
                
                if winner != 0:
                    break
            if winner != 0:
                break
        
        # Вивід результату
        if winner != 0:
            print(winner)
            print(f"{win_r} {win_c}")
        else:
            print(0)

if __name__ == '__main__':
    solve()
